{
  "manifest_version": 3,
  "name": "AlcoGym",
  "version": "1.2.0",
  "description": "Turns AlgoGym into AlcoGym",
  "browser_specific_settings": {
    "gecko": {
      "id": "bigzyabra@gmail.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "AlcoGym",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://algogym.ru/*",
        "https://www.algogym.ru/*",
        "http://algogym.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.svg"],
      "matches": [
        "https://algogym.ru/*",
        "https://www.algogym.ru/*",
        "http://algogym.ru/*"
      ]
    }
  ]
}
